{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "babdev/pagerfanta-bundle": "^4.5",
        "doctrine/dbal": "^3.10.2",
        "doctrine/doctrine-bundle": "^2.17.0",
        "doctrine/doctrine-migrations-bundle": "^3.4.2",
        "doctrine/orm": "^3.5.2",
        "lexik/jwt-authentication-bundle": "^3.1.1",
        "meilisearch/search-bundle": "^0.15.9",
        "nelmio/api-doc-bundle": ">=5.6.2",
        "nyholm/psr7": "^1.8.2",
        "pagerfanta/doctrine-orm-adapter": "^4.7.1",
        "pagerfanta/twig": ">=4.7.1",
        "payplug/payplug-php": "^3.7",
        "php-http/discovery": ">=1.20",
        "phpdocumentor/reflection-docblock": "^5.6.3",
        "phpstan/phpdoc-parser": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0.10",
        "psr/http-factory-implementation": "*",
        "symfony/asset": "7.2.*",
        "symfony/asset-mapper": "7.2.*",
        "symfony/console": "7.2.*",
        "symfony/doctrine-messenger": "7.2.*",
        "symfony/dotenv": "7.2.*",
        "symfony/expression-language": "7.2.*",
        "symfony/flex": "^2.8.2",
        "symfony/form": "7.2.*",
        "symfony/framework-bundle": "7.2.*",
        "symfony/http-client": "7.2.*",
        "symfony/intl": "7.2.*",
        "symfony/mailer": "7.2.*",
        "symfony/mime": "7.2.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/notifier": "7.2.*",
        "symfony/process": "7.2.*",
        "symfony/property-access": "7.2.*",
        "symfony/property-info": "7.2.*",
        "symfony/runtime": "7.2.*",
        "symfony/security-bundle": "7.2.*",
        "symfony/serializer": "7.2.*",
        "symfony/stimulus-bundle": "^2.30",
        "symfony/string": "7.2.*",
        "symfony/translation": "7.2.*",
        "symfony/twig-bundle": "7.2.*",
        "symfony/ux-turbo": "^2.30",
        "symfony/validator": "7.2.*",
        "symfony/web-link": "7.2.*",
        "symfony/yaml": "7.2.*",
        "symfonycasts/verify-email-bundle": "^1.17.4",
        "twig/extra-bundle": "^2.12|^3.21",
        "twig/twig": "^2.12|^3.21.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "db": [
            "symfony console doctrine:database:drop -f --if-exists",
            "symfony console doctrine:database:create",
            "symfony console doctrine:migrations:migrate -n",
            "symfony console doctrine:fixtures:load -n "
        ],
        "db-test": [
            "php bin/console doctrine:database:drop -f --if-exists --env=test",
            "php bin/console doctrine:database:create --env=test",
            "php bin/console doctrine:migrations:migrate -n --env=test",
            "php bin/console doctrine:fixtures:load --env=test --no-interaction"
        ],
        "test": [
            "composer db-test",
            "php bin/phpunit" 
        ],
        "app:code-quality":[
            "php -v",
            "./vendor/bin/ecs check",
            "php bin/console lint:yaml config --parse-tags",
            "php bin/console lint:twig templates",
            "php bin/console lint:container",
            "./vendor/bin/phpstan analyse --memory-limit=-1",
            "./vendor/bin/rector --version",
            "./vendor/bin/rector --dry-run"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]       
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    },
    "require-dev": {
        "blackfire/php-sdk": "^2.5.8",
        "dbrekelmans/bdi": "^1.4",
        "doctrine/doctrine-fixtures-bundle": "^4.1",
        "phpstan/phpstan": "^2.1.30",
        "phpstan/phpstan-symfony": "^2.0.8",
        "phpunit/phpunit": "^9.6.29",
        "rector/rector": "^2.2.1",
        "symfony/browser-kit": "7.2.*",
        "symfony/css-selector": "7.2.*",
        "symfony/debug-bundle": "7.2.*",
        "symfony/maker-bundle": "^1.64.0",
        "symfony/panther": "^2.2",
        "symfony/phpunit-bridge": "^7.3.4",
        "symfony/stopwatch": "7.2.*",
        "symfony/web-profiler-bundle": "7.2.*",
        "symplify/easy-coding-standard": "^12.6",
        "zenstruck/foundry": "^2.7.4"
    }
}
